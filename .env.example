# --- Banco (Postgres 18; docker compose up -d postgres) ---
# Obrigatório: memória, pedidos, sessões e mapeamento moram aqui. Fora de dev, rode
# okf-admin importar-json -dir okf/var antes do primeiro boot.
DATABASE_URL=postgres://concierge:concierge@127.0.0.1:5432/concierge?sslmode=disable

# --- Acesso ---
# AUTH_MODE=dev aceita o usuário do cabeçalho X-Dev-Usuario ou, sem ele, AUTH_DEV_USUARIO
# (a migration semeia admin-superlogica). Só com AMBIENTE vazio ou dev; sem ele, a API fica fechada.
AUTH_MODE=dev
AUTH_DEV_USUARIO=admin-superlogica

# --- Modelo de linguagem (mesmos nomes do sl-concierge; copie para .env) ---
LLM_MODE=gemini                     # gemini | openrouter | luna | mock
# usado com LLM_MODE=gemini (endpoint OpenAI-compatível do Google)
GEMINI_API_KEY=
# usado com LLM_MODE=openrouter
OPENROUTER_API_KEY=
LLM_LUNA_OPENAI_URL=https://kong-ai-gtw.idp.nexus.superlogica.net/v1
# usado com LLM_MODE=luna
LLM_LUNA_GATEWAY_TOKEN=
LLM_LUNA_MODEL=gpt-6-luna
# Modelos por tarefa; o okf-run usa MODEL_PLANNER como padrão quando o agent.yaml não diz.
MODEL_EXTRACT=gemini-2.5-flash-lite
MODEL_PLANNER=gemini-2.5-flash
MODEL_COMPOSE=gemini-2.5-flash-lite
MODEL_CHEAP=gemini-2.5-flash-lite
# Com LLM_MODE=openrouter use os slugs do OpenRouter: google/gemini-2.5-flash, anthropic/claude-haiku-4.5 ...
# Com LLM_MODE=luna deixe MODEL_* vazios para usar LLM_LUNA_MODEL ou informe modelos válidos do gateway.
GEMINI_PRICE_IN=0.10                # US$ por 1M tokens de entrada (estimativa para o ledger)
GEMINI_PRICE_OUT=0.40

# --- Gruvi (identidade do morador pelo telefone) ---
GRUVI_BFF_URL=https://b2c-nexus.superlogica.net/api/gruvi
GRUVI_COMPANY_ID=5982                # companies/{id} no BFF

# --- ATENDE ---
# Configuração da conexão real única. O webhook confere sempre o HMAC com ATENDE_API_SECRET;
# fora de dev o boot falha sem ele.
ATENDE_API_SECRET=
# Envio, transbordo e encerramento passam pelo gateway Nexus (servidor MCP `atende`).
# A chave do ATENDE fica no gateway; aqui só o token de serviço. Sem ATENDE_MCP_URL o canal
# real fica desligado (o emulador segue).
ATENDE_MCP_URL=                      # <gateway>/mcp/atende
ATENDE_MCP_TOKEN_URL=                # <gateway>/api/mcp/token
ATENDE_MCP_CLIENT_ID=
ATENDE_MCP_CLIENT_SECRET=
ATENDE_TENANT_ID=
ATENDE_TENANT_TELEFONE=
# Token legado aplicado somente à rota do emulador/Console.
ATENDE_WEBHOOK_TOKEN=
# Compatibilidade legada; a resposta real usa ATENDE_MCP_URL.
ATENDE_REPLY_URL=
ATENDE_REPLY_TOKEN=
ATENDE_AGENTE=agentes/concierge      # agente de primeiro nível que atende o canal

# --- Catálogo MCP oficial (servidor da entrega em mcp/, docker compose: serviço mcp) ---
# As tools do servidor viram recursos do Nexus (classe api, privados); o harness as chama
# por tools/call. Sem MCP_URL, só o Nexus ou o instantâneo okf/nexus/<account>.yaml.
MCP_URL=http://127.0.0.1:3337/mcp/gruvi/bff
MCP_AUTH=b2c                                  # b2c | file | bearer | keycloak | none
# b2c: token de morador pelo fluxo SMS de dev do Spaces (5 min), renovado pelo refresh_token
# e opcionalmente gravado em MCP_TOKEN_FILE para inspeção local
# telefone de teste (validation=dev, sms_code=999999)
MCP_B2C_MOBILE=
MCP_B2C_URL=https://api.superlogica.com/spaces/v1
MCP_B2C_FINGERPRINT=fingerprint-teste
MCP_TOKEN_FILE=okf/var/b2c.token              # no compose: /app/okf/var/b2c.token
# modo bearer: um token fixo (expira)
MCP_BEARER_TOKEN=
# modo keycloak: token por client_credentials
MCP_KEYCLOAK_URL=
MCP_KEYCLOAK_CLIENT_ID=
MCP_KEYCLOAK_CLIENT_SECRET=
# padrão: 127.0.0.1:porta fora de loopback (o servidor exige)
MCP_HOST_HEADER=
